# Django Settings - REQUIRED: Generate key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-a-secure-key-with-command-above
DJANGO_DEBUG=True

# Database Configuration
# Option 1: Use full DATABASE_URL (recommended for production)
# DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Use individual database parameters (for development)
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_NAME=your-db-name
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password

# Development Settings
DEVELOPER_MODE=True
AUDIT_DASHBOARD_DEV_ONLY=True

# Allowed Hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,172.20.48.1,10.39.110.47,192.168.43.185

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# Production Settings (uncomment for production)
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=ndtech.onrender.com,ndtechpos.onrender.com,.onrender.com
# CORS_ALLOWED_ORIGINS=https://ndtechpos.onrender.com
# CSRF_TRUSTED_ORIGINS=https://ndtechpos.onrender.com

# Firebase Cloud Messaging (optional)
FCM_API_KEY=your-fcm-api-key
FCM_SENDER_ID=your-fcm-sender-id
FCM_PROJECT_ID=your-fcm-project-id

# Logging
LOG_LEVEL=INFO

# Render Deployment (uncomment when deploying to Render)
# RENDER_URL=https://ndtechpos.onrender.com
# DATABASE_URL=postgresql://user:password@host:port/database
