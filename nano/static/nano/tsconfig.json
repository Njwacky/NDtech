{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outFile": "home.min.js",
    "sourceMap": false,
    "removeComments": true,
    "noImplicitAny": false,
    "allowJs": true,
    "declaration": false,
    "lib": ["DOM", "ES2020"]
  },
  "include": [
    "home.ts"
  ],
  "exclude": [
    "node_modules",
    "*.min.js"
  ]
}
